{
  "name": "dorado-lounge-system",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "pnpm --parallel --filter './apps/*' dev",
    "build": "pnpm --parallel --filter './apps/*' build",
    "test": "pnpm --recursive --if-present test",
    "lint": "pnpm --recursive --if-present lint",
    "typecheck": "pnpm --recursive --if-present typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "reset:test-users": "node --env-file=apps/web/.env.local scripts/reset-test-users.mjs",
    "prepare": "husky",
    "rbac:generate": "UPDATE_RBAC=1 pnpm --filter @dorado/web exec vitest run src/lib/auth/tests/rbac-sql.test.ts"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "prettier --write"
    ],
    "*.{css,json,md,yaml,yml}": [
      "prettier --write"
    ]
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "unrs-resolver",
      "@swc/core",
      "@sentry/cli",
      "@parcel/watcher"
    ],
    "overrides": {
      "brace-expansion": ">=5.0.9",
      "fast-uri": ">=3.1.5",
      "js-yaml@4": ">=4.3.1",
      "nanoid@3": ">=3.3.18",
      "postcss": ">=8.5.18",
      "sharp": ">=0.35.0",
      "socket.io-parser": ">=4.2.7",
      "ws": ">=8.21.0"
    }
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.3"
  }
}
