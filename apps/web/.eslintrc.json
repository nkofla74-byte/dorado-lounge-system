{
  "extends": ["next/core-web-vitals", "prettier"],
  "rules": {
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": ["**/infrastructure/**"],
            "message": "Violación hexagonal: domain/ y application/ no pueden importar de infrastructure/"
          },
          {
            "group": ["@supabase/*"],
            "message": "Solo infrastructure/ puede usar Supabase directamente"
          }
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": ["src/modules/*/infrastructure/**/*.ts"],
      "rules": {
        "no-restricted-imports": "off"
      }
    },
    {
      "files": ["src/modules/*/actions.ts", "src/app/**/*actions.ts", "src/app/api/**/*.ts"],
      "rules": {
        "no-restricted-imports": "off"
      }
    },
    {
      "files": [
        "src/lib/supabase/**/*.ts",
        "src/lib/socket/**/*.ts",
        "src/lib/auth/**/*.ts",
        "src/middleware.ts"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ]
}
