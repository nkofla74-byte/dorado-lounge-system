{
  "name": "@dorado/socket-server",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc --noEmit && esbuild src/index.ts --bundle --platform=node --target=node22 --outfile=dist/index.js",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@axiomhq/pino": "^1.6.1",
    "@dorado/shared-types": "workspace:*",
    "@sentry/node": "^10.53.1",
    "dotenv": "^17.4.2",
    "jose": "^6.2.3",
    "jsonwebtoken": "^9.0.3",
    "pino": "^9.5.0",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@dorado/eslint-config": "workspace:*",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.59.1",
    "@typescript-eslint/parser": "^8.59.1",
    "esbuild": "^0.28.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^10.1.8",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
