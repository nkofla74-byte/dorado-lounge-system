# ── apps/web ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# URL del socket-server (Render.com en producción, localhost en dev)
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001
# PRODUCCIÓN: NEXT_PUBLIC_SOCKET_URL=https://dorado-lounge-socket.onrender.com

# API vuelos El Dorado — proveedor TBD (Sprint 6)
FLIGHTS_API_KEY=
FLIGHTS_API_URL=

# Firma tokens QR anónimos de mesa (12 h TTL — ver lib/qr/token.ts; nunca NEXT_PUBLIC_*)
JWT_PASSENGER_SECRET=

# ── apps/socket-server ────────────────────────────────────────────────────────
# No lleva SUPABASE_SERVICE_ROLE_KEY: el servicio no accede a la base. Darle la
# clave que puentea toda la RLS a un proceso expuesto a internet solo amplía el
# radio de exposición (F-027).
PORT=3001
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_JWT_SECRET=
ALLOWED_ORIGIN=http://localhost:3000
# PRODUCCIÓN: ALLOWED_ORIGIN=https://dorado-lounge-system-web.vercel.app

# Secreto compartido web → socket-server para el endpoint POST /emit
# Generar con: openssl rand -hex 32
SOCKET_EMIT_SECRET=

# ── Observabilidad (ambas apps) ───────────────────────────────────────────────
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
AXIOM_TOKEN=
AXIOM_DATASET=dorado-lounge

# Better Stack — uptime heartbeat. Lo emite ÚNICAMENTE /api/heartbeat, es decir
# la propia aplicación: si Vercel está caído, el latido no llega y el monitor
# salta. Configura el intervalo esperado acorde al cron de vercel.json (diario).
# Para detección rápida de caídas, añade además un monitor HTTP contra /health.
BETTERSTACK_HEARTBEAT_URL=https://uptime.betterstack.com/api/v1/heartbeat/<token>

# Vercel Cron secret — protege el endpoint /api/heartbeat
# Generar con: openssl rand -hex 32
CRON_SECRET=

# ── Seguridad ─────────────────────────────────────────────────────────────────
# Cloudflare Turnstile (login + QR PWA) — Sprint 3
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Upstash Redis — rate limiting (login, crons, GDPR forget).
# Crea una DB en upstash.com y copia REST URL + Token.
# Sin estas variables el rate limiter es "fail-open" (no-op), útil en dev.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── CI/CD secrets (GitHub Actions) ───────────────────────────────────────────
# VERCEL_TOKEN=          (Settings → Tokens en vercel.com)
# SUPABASE_DB_URL=       (Settings → Database → Connection string en supabase.com)
# E2E_SUPABASE_URL=      (proyecto de staging para E2E)
# E2E_SUPABASE_ANON_KEY=
# E2E_SOCKET_URL=
# E2E_ADMIN_EMAIL=
# E2E_ADMIN_PASSWORD=
# E2E_CHEF_EMAIL=
# E2E_CHEF_PASSWORD=

# ── Disaster Recovery — backup diario (.github/workflows/backup.yml) ──────────
# SUPABASE_DB_HOST=      (Settings → Database → Host en supabase.com)
# SUPABASE_DB_PASSWORD=  (Settings → Database → Password)
# BETTERSTACK_BACKUP_HEARTBEAT_URL=  (monitor separado para el job de backup)
# Backup S3 opcional (sin estas vars el backup solo va a GitHub Artifacts):
# BACKUP_S3_BUCKET=
# BACKUP_AWS_ACCESS_KEY_ID=
# BACKUP_AWS_SECRET_ACCESS_KEY=
# BACKUP_AWS_REGION=us-east-1
