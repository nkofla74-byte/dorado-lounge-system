# ── apps/web ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# URL del socket-server (Render.com en producción, localhost en dev)
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001
# PRODUCCIÓN: NEXT_PUBLIC_SOCKET_URL=https://dorado-lounge-socket.onrender.com

# API vuelos El Dorado — proveedor TBD (Sprint 6)
FLIGHTS_API_KEY=
FLIGHTS_API_URL=

# Firma tokens QR anónimos de mesa (4 h TTL, nunca NEXT_PUBLIC_*)
JWT_PASSENGER_SECRET=

# ── apps/socket-server ────────────────────────────────────────────────────────
PORT=3001
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SOCKET_JWT_SECRET=
ALLOWED_ORIGIN=http://localhost:3000
# PRODUCCIÓN: ALLOWED_ORIGIN=https://dorado-lounge-system-web.vercel.app

# Secreto compartido web → socket-server para el endpoint POST /emit
# Generar con: openssl rand -hex 32
SOCKET_EMIT_SECRET=

# ── Observabilidad (ambas apps) ───────────────────────────────────────────────
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
AXIOM_TOKEN=
AXIOM_DATASET=dorado-lounge

# Better Stack — uptime heartbeat (configura el monitor en betterstack.com/uptime)
# Intervalo esperado: 5 minutos (coincide con el Vercel Cron en vercel.json)
BETTERSTACK_HEARTBEAT_URL=https://uptime.betterstack.com/api/v1/heartbeat/<token>

# Vercel Cron secret — protege el endpoint /api/heartbeat
# Generar con: openssl rand -hex 32
CRON_SECRET=

# ── Seguridad ─────────────────────────────────────────────────────────────────
# Cloudflare Turnstile (login + QR PWA) — Sprint 3
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── CI/CD secrets (GitHub Actions) ───────────────────────────────────────────
# VERCEL_TOKEN=          (Settings → Tokens en vercel.com)
# SUPABASE_DB_URL=       (Settings → Database → Connection string en supabase.com)
# E2E_SUPABASE_URL=      (proyecto de staging para E2E)
# E2E_SUPABASE_ANON_KEY=
# E2E_SOCKET_URL=
# E2E_ADMIN_EMAIL=
# E2E_ADMIN_PASSWORD=
# E2E_CHEF_EMAIL=
# E2E_CHEF_PASSWORD=
